# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
# Applyly local runtime and database state
/.wrangler/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/.dev-*.log

# Local/private Codex workspace metadata
/.codex/
/.agents/

# Personal Sites hosting configuration (use .openai/hosting.example.json)
/.openai/hosting.json
!/.openai/hosting.example.json

