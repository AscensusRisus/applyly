{
  "manifest_version": 3,
  "name": "Applyly Companion",
  "version": "0.5.0",
  "description": "Capture job details, keep a browser draft, and check local Applyly history.",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Check with Applyly",
    "default_popup": "popup.html"
  }
}
